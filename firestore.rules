rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Listings — anyone can read, only @bu.edu Google users can write their own
    match /listings/{userId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.token.email.matches(".*@bu\\.edu");

      allow update, delete: if request.auth != null
                            && request.auth.uid == userId;
    }

    // Contacts — only signed-in @bu.edu users can read, owner can write
    match /contacts/{userId} {
      allow read: if request.auth != null
                  && request.auth.token.email.matches(".*@bu\\.edu");

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.auth.token.email.matches(".*@bu\\.edu");

      allow update, delete: if request.auth != null
                            && request.auth.uid == userId;
    }

    // Housing Photo Submissions — anyone can submit, only @bu.edu users can read
    match /housingSubmissions/{submissionId} {
      allow read: if request.auth != null
                  && request.auth.token.email.matches(".*@bu\\.edu");
      allow update, delete: if false;

      allow create: if request.resource.data.keys().hasAll(
                      ['campusGroup', 'address', 'layout', 'photoTypes', 'photos', 'submittedAt']
                    )
                    && request.resource.data.campusGroup is string
                    && request.resource.data.address is string
                    && request.resource.data.layout is string
                    && request.resource.data.photoTypes is list
                    && request.resource.data.photos is list
                    && request.resource.data.photos.size() > 0
                    && request.resource.data.photos.size() <= 20;
    }
  }
}
